# Agent behaviour (src/agents). Defaults shown; none of these is a secret.
CONFLICT_POLICY=escalate        # escalate | stricter | bylaws | rmp : which source applies when the bye-laws and the RMP disagree
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_WALL_S=60
AGENT_VERIFY_RETRIES=1
AGENT_PLANNER=rule              # rule | llm | single (single = one-search baseline for the L3 comparison)
