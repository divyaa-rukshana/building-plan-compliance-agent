
# Application Settings
APP_ENV=development
PORT=8000

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# LLM & Agent Configuration
LLM_API_BASE=http://stub-llm:8001
LLM_PROVIDER=stub
OPENAI_API_KEY=
MODEL_NAME=llama3.2

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Agent Behaviour
CONFLICT_POLICY=escalate
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_WALL_S=60
AGENT_VERIFY_RETRIES=1
AGENT_PLANNER=rule
PROMPT_VERSION=v1
CORPUS_BACKEND=stub

# Cost Tracking (placeholder rates)
PRICE_PROMPT_PER_1K=0.0015
PRICE_COMPLETION_PER_1K=0.0020
